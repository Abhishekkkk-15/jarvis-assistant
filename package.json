{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "dev": "turbo dev",
    "dev:desktop": "npx concurrently -n \"API,ELECTRON\" -c \"bgBlue.bold,bgMagenta.bold\" \"pnpm --filter @workspace/api-server dev\" \"pnpm --filter @workspace/jarvis electron:dev\"",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "@types/node": "catalog:",
    "prettier": "^3.8.3",
    "turbo": "^2.9.16",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@hurdlegroup/robotjs",
      "electron",
      "extract-file-icon",
      "node-window-manager",
      "better-sqlite3",
      "esbuild"
    ]
  }
}